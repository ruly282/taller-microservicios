{
  "name": "Taller de microservicios",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:2": { "version": "24" },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "forwardPorts": [5000, 3000],
  "portsAttributes": {
    "5000": { "label": "menu (C#)" },
    "3000": { "label": "pedidos (Node.js)" },
    "1433": { "label": "SQL Server", "onAutoForward": "ignore" }
  },
  "postCreateCommand": "bash .devcontainer/preparar.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "humao.rest-client"
      ]
    }
  }
}
